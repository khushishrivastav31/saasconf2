# Database
DB_PASSWORD=your_secure_password_here

# JWT Security (CHANGE IN PRODUCTION!)
JWT_SECRET_KEY=generate-a-secure-random-key-here

# Super Admin Credentials (CHANGE IN PRODUCTION!)
SUPER_ADMIN_EMAIL=admin@saasconf.com
SUPER_ADMIN_PASSWORD=changeme123

# Frontend
VITE_API_URL=http://localhost:8000

# Email — platform-level Resend key. Distinct from per-tenant Resend keys
# (which tenants configure in My Company → Email). Used as the system sender for
# platform emails sent before a tenant has its own key — notably the welcome
# email dispatched when a super-admin creates a new tenant. Leave empty to fall
# back to the Mailgun system account. Sends from RESEND_FROM_EMAIL.
RESEND_API_KEY=

# Bot protection on the three public registration forms (conference,
# training, CFP applicant signup). Get keys from
# https://www.google.com/recaptcha/admin (reCAPTCHA v3, one site/secret pair
# per project — same key powers all three portals). Leave both empty in
# dev/test to skip captcha validation entirely; the system stays functional.
RECAPTCHA_SECRET_KEY=
VITE_RECAPTCHA_SITE_KEY=
