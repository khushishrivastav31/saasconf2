# pnpm configuration (also honoured by npm where applicable).
#
# ``auto-install-peers=true`` (pnpm default since v8) installs missing
# peer dependencies automatically. Without this you'd have to add them
# explicitly to package.json — fine but extra ceremony.
auto-install-peers=true

# eslint-plugin-react-hooks@7 declares peer eslint@"^9" but works fine
# with eslint@10. ``strict-peer-dependencies=false`` lets pnpm install
# despite the version mismatch (npm's equivalent was the legacy-peer-deps
# escape hatch this file used to set). Remove once react-hooks v8.x
# ships with the right peer declaration.
strict-peer-dependencies=false

# Postinstall security (pnpm 9+): only the packages listed in
# ``pnpm.onlyBuiltDependencies`` (in package.json) get to run postinstall
# scripts. Everything else is blocked, blunting the supply-chain attack
# class where a transitive dep ships a malicious postinstall.
# This setting is the explicit opt-out of pnpm's default block — kept
# false so the allowlist in package.json is the single source of truth.
ignore-scripts=false
