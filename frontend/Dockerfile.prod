# Build stage
# node:22.22.2-alpine
FROM node:24.15.0-alpine@sha256:d1b3b4da11eefd5941e7f0b9cf17783fc99d9c6fc34884a665f40a06dbdfc94f AS builder

# Pin pnpm via npm — same version as package.json's ``packageManager`` field
# and the CI workflow. Bumping in one place means bumping in all three.
RUN npm install -g pnpm@10.33.2

WORKDIR /app

# Install dependencies. ``--frozen-lockfile`` matches CI behaviour. The
# previous ``--legacy-peer-deps`` workaround moved into ``.npmrc`` as
# pnpm's ``strict-peer-dependencies=false`` (same effect, scoped to this
# project rather than a global npm flag).
COPY package.json pnpm-lock.yaml .npmrc ./
RUN pnpm install --frozen-lockfile

# Copy source and build
COPY . .

# Build arguments for environment variables (baked into static files)
ARG VITE_API_URL
ARG VITE_SENTRY_DSN
ARG VITE_SENTRY_ENVIRONMENT
ARG VITE_APP_VERSION

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_SENTRY_ENVIRONMENT=$VITE_SENTRY_ENVIRONMENT
ENV VITE_APP_VERSION=$VITE_APP_VERSION

RUN pnpm run build

# Production stage
# nginx:1.27-alpine
FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10

# Copy custom nginx config
COPY deploy/nginx.conf /etc/nginx/nginx.conf

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget -q --spider http://localhost:80/health || exit 1

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
