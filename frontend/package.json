{
  "name": "saasconf-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "dev:portal": "vite --port 3002",
    "build": "tsc && vite build",
    "lint": "eslint src --max-warnings 106",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "gen:api": "node scripts/generate-api-types.mjs",
    "gen:api:check": "node scripts/generate-api-types.mjs --check",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 106 --no-warn-ignored",
      "prettier --write"
    ],
    "src/**/*.css": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "// onlyBuiltDependencies": "Postinstall security allowlist (pnpm 9+). Every other dep's postinstall script is blocked, blunting supply-chain attacks. Add a package here only if its install legitimately needs to run code (native binaries, browser downloads).",
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "// overrides": "Force-resolve transitive deps that have known vulnerabilities. d3-color@<3.1.0 has GHSA-36jr-mh4h-2g58 (ReDoS, HIGH). dompurify@<3.3.2 has 8 moderate mXSS/XSS advisories (GHSA-h8r8-wccr-v5f2 et al.); monaco-editor exact-pins 3.2.7 so we have to override.",
    "overrides": {
      "d3-color": ">=3.1.0",
      "dompurify": ">=3.3.2"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@sentry/react": "^10.53.1",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.5.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-virtual": "^3.13.24",
    "@tiptap/core": "^3.23.4",
    "@tiptap/extension-color": "^3.23.4",
    "@tiptap/extension-font-family": "^3.23.4",
    "@tiptap/extension-highlight": "^3.23.4",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-subscript": "^3.23.4",
    "@tiptap/extension-superscript": "^3.23.4",
    "@tiptap/extension-table": "^3.23.4",
    "@tiptap/extension-table-cell": "^3.23.4",
    "@tiptap/extension-table-header": "^3.23.4",
    "@tiptap/extension-table-row": "^3.23.4",
    "@tiptap/extension-task-item": "^3.23.4",
    "@tiptap/extension-task-list": "^3.23.4",
    "@tiptap/extension-text-align": "^3.23.4",
    "@tiptap/extension-text-style": "^3.23.4",
    "@tiptap/extension-underline": "^3.23.4",
    "@tiptap/extension-youtube": "^3.23.4",
    "@tiptap/pm": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "axios": "^1.16.1",
    "dompurify": "^3.4.3",
    "ibantools": "^4.5.4",
    "libphonenumber-js": "^1.13.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-hook-form": "^7.75.0",
    "react-pdf": "^10.4.1",
    "react-router": "^7.15.0",
    "react-simple-maps": "^3.0.0",
    "recharts": "^2.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.3.3",
    "vitest": "^3.2.4"
  },
  "//overrides": "d3-color >=3.1.0 required to fix CVE in older versions (transitive dep from recharts)",
  "overrides": {
    "d3-color": "^3.1.0"
  }
}
