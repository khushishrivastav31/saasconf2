# python:3.12.10-slim
FROM python:3.12.10-slim@sha256:97983fa8cc88343512862c62307159a82261c3528dc025f79e5a3f7af43e50b4 AS builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies to a virtual environment
# NOTE: This project uses Poetry for local development (see pyproject.toml).
# The Docker build uses pip + requirements.txt for faster, smaller images.
# To regenerate requirements.txt from Poetry:
#   poetry export -f requirements.txt --output requirements.txt
# For production builds with hash verification, add --require-hashes to pip install
COPY requirements.txt pyproject.toml poetry.lock* ./
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

# Production image
# python:3.12.10-slim
FROM python:3.12.10-slim@sha256:97983fa8cc88343512862c62307159a82261c3528dc025f79e5a3f7af43e50b4

WORKDIR /app

# Install runtime dependencies (includes WeasyPrint system libs for PDF generation)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libpangoft2-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    libffi8 \
    libglib2.0-0 \
    fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY alembic.ini .
COPY app ./app
COPY scripts ./scripts

# Create non-root user
RUN adduser --disabled-password --gecos '' --uid 1001 appuser \
    && chown -R appuser:appuser /app /opt/venv
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

# Production command: uvicorn with multiple workers
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers ${UVICORN_WORKERS:-2}"]
