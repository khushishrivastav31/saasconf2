# ===========================================
# SaaSConf Backend - Local Development
# ===========================================
# Copy this file to .env: cp .env.example .env

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://saasconf:saasconf_dev_password@localhost:5432/saasconf

# Redis
REDIS_URL=redis://localhost:6379

# JWT Security (minimum 32 characters)
JWT_SECRET_KEY=dev-secret-key-for-local-development-only-32chars
JWT_ALGORITHM=HS256

# PII column encryption (Fernet key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# Required once phase (f) is live — email/phone/VAT are stored encrypted and
# login + lookups resolve via the *_hash column. See
# docs/runbooks/pii-encryption-key-management.md.
PII_ENCRYPTION_KEY=
# Optional: comma-separated old keys kept for read fallback during rotation
PII_ENCRYPTION_KEYS_OLD=

# Super Admin Credentials
SUPER_ADMIN_EMAIL=admin@saasconf.com
SUPER_ADMIN_PASSWORD=changeme123

# CORS (JSON array or comma-separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Debug mode
DEBUG=true

# Sentry (leave empty to disable)
SENTRY_DSN=

# Email - Resend (leave empty to use console logging)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@localhost
