# ===========================================
# SaaSConf Staging Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# Domain Configuration
DOMAIN=staging.yourapp.com
ACME_EMAIL=admin@yourapp.com

# Database
DB_USER=saasconf
DB_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD
DB_NAME=saasconf

# Require SSL for DB connections. Set to "true" when DATABASE_URL points to an
# EXTERNAL Postgres (e.g. managed RDS / DigitalOcean / Neon). Leave "false"
# only if the DB runs on the same private Docker network as the backend.
# Production MUST be "true" — startup logs a SECURITY warning otherwise.
DATABASE_SSL_REQUIRED=false

# JWT Security (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# PII column encryption (Fernet key)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required in staging + production — login uses hash lookup; dual-write encrypts on insert/update.
# See backend/docs/runbooks/pii-encryption-key-management.md.
# NEVER reuse the dev or production key here — each environment needs its own.
PII_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_FERNET
# Optional: comma-separated old keys kept for read fallback during rotation
PII_ENCRYPTION_KEYS_OLD=

# Super Admin Credentials
SUPER_ADMIN_EMAIL=admin@yourcompany.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# Ops API Key for cron services — REQUIRED, no fallback (generate with: openssl rand -hex 32)
OPS_API_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# Login rate limit (slowapi format). "10/minute" for production, "30/minute" for staging (Playwright E2E).
# Account lockout (5 failed attempts → 15min) is the primary brute-force defense; this is secondary.
RATE_LIMIT_LOGIN=30/minute

# Frontend/Portal URLs (used in email links)
FRONTEND_BASE_URL=https://staging.yourapp.com
PORTAL_BASE_URL=https://staging.yourapp.com

# Sentry (optional - leave empty to disable)
SENTRY_DSN_BACKEND=
SENTRY_DSN_FRONTEND=

# Email (Resend - get API key from resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# App Version (updated during deployment)
APP_VERSION=0.1.0

# Stripe (optional - leave empty to disable payments)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
